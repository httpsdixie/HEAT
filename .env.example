# ── Administrator account ─────────────────────────────────────────────────────
# The email address for the administrator account.
# IMPORTANT: Set this BEFORE running ORCHID for the first time.
# After first-time setup this can only be changed from inside the app.
ORCHID_ADMIN_EMAIL=admin@orchid.local

# ── SMTP (email delivery) ─────────────────────────────────────────────────────
# SMTP is NOT required to run ORCHID or to sign in.
# It is only needed for: password recovery, password changes, and email changes.
# If you skip this, use scripts/reset_password.py if you are ever locked out.
#
# For Gmail: use smtp.gmail.com on port 587.
# Gmail requires 2-Step Verification and an App Password — use that as
# ORCHID_SMTP_PASSWORD, not your regular Gmail password.

# Hostname of your SMTP server (e.g. smtp.gmail.com)
ORCHID_SMTP_HOST=smtp.gmail.com

# Port: 587 uses STARTTLS (recommended). 465 uses TLS.
ORCHID_SMTP_PORT=587

# The login username for the SMTP server (usually the sending email address)
ORCHID_SMTP_USER=

# The password or App Password for the SMTP login above
ORCHID_SMTP_PASSWORD=

# The From address that appears on outgoing emails.
# If blank, ORCHID_SMTP_USER is used as the sender.
ORCHID_SMTP_FROM=

# ── Optional overrides ────────────────────────────────────────────────────────
# Path to the SQLite database file. Leave blank to use the default (DB/orchid.db).
# ORCHID_DB_FILE=

# Folder where automatic backups are saved. Leave blank for DB/backups/.
# ORCHID_BACKUP_DIR=

# Number of backup copies to keep before the oldest is deleted. Default: 7.
# ORCHID_BACKUP_KEEP=7
